{
  "name": "dwc-config-backup-core",
  "version": "0.1.5",
  "type": "module",
  "description": "Framework-free core of the whole-machine configuration backup & restore feature for DuetWebControl plugins: archive format, redaction engine, restore planner, credential storage/encryption and cloud destination adapters (Duet service, GitHub, Dropbox, WebDAV, Google Drive). No Vue, Pinia/Vuex or DWC imports, so it can be consumed by both DWC 3.6 (Vue 2) and DWC 3.7 (Vue 3) plugins.",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/jaysuk/dwc-config-backup-core",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js"
    },
    "./hostConfig": {
      "types": "./dist/hostConfig.d.ts",
      "import": "./dist/hostConfig.js"
    },
    "./collect": {
      "types": "./dist/collect.d.ts",
      "import": "./dist/collect.js"
    },
    "./archive": {
      "types": "./dist/archive.d.ts",
      "import": "./dist/archive.js"
    },
    "./restore": {
      "types": "./dist/restore.d.ts",
      "import": "./dist/restore.js"
    },
    "./sanitise": {
      "types": "./dist/sanitise.d.ts",
      "import": "./dist/sanitise.js"
    },
    "./repair": {
      "types": "./dist/repair.d.ts",
      "import": "./dist/repair.js"
    },
    "./credentials": {
      "types": "./dist/credentials.d.ts",
      "import": "./dist/credentials.js"
    },
    "./credentialsSdSync": {
      "types": "./dist/credentialsSdSync.d.ts",
      "import": "./dist/credentialsSdSync.js"
    },
    "./credentialsMigrate": {
      "types": "./dist/credentialsMigrate.d.ts",
      "import": "./dist/credentialsMigrate.js"
    },
    "./destinations/*": {
      "types": "./dist/destinations/*.d.ts",
      "import": "./dist/destinations/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.8",
    "happy-dom": "^15.11.7",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/*"
      ]
    }
  }
}
